# Judge setup: fill in your own key, then run docker compose up.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
G4_EVAL_PROVIDER=cerebras
# Optional legacy CLI providers, not needed for the judge dashboard.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
# Optional USD per million token overrides for inference cost estimates.
# The default gpt-oss-120b rate is recorded in each trace's cost_estimate_basis.
# CEREBRAS_INPUT_USD_PER_MILLION=0.35
# CEREBRAS_OUTPUT_USD_PER_MILLION=0.75
